<%- include('../partials/cabeza') %>
<header class="encabezado">
  <div class="encabezado__texto">
    <h1 class="titulo">Clientes</h1>
    <p class="texto"><%= clientes.length %> <%= clientes.length === 1 ? 'cliente' : 'clientes' %><%= buscar ? ` que coinciden con "${buscar}"` : ' registrados' %></p>
  </div>
  <a class="boton boton--primario" href="/clientes/nuevo"><svg aria-hidden="true"><use href="#i-mas"/></svg>Nuevo cliente</a>
</header>

<% if (ok) { %><%- include('../partials/aviso', { tipo: 'ok', titulo: null, mensaje: ok }) %><div class="espacio"></div><% } %>

<form class="filtros" role="search" action="/clientes" method="get">
  <div class="campo">
    <label class="campo__etiqueta" for="q">Buscar</label>
    <input class="entrada" id="q" name="q" type="search" value="<%= buscar %>" placeholder="Nombre, apellido o correo…" autocomplete="off" spellcheck="false">
  </div>
  <button class="boton boton--secundario" type="submit"><svg aria-hidden="true"><use href="#i-buscar"/></svg>Buscar</button>
  <% if (buscar) { %><a class="boton boton--fantasma" href="/clientes">Quitar filtro</a><% } %>
</form>

<% if (clientes.length === 0) { %>
  <div class="vacio">
    <p class="subtitulo"><%= buscar ? 'Ningún cliente coincide' : 'Aún no hay clientes' %></p>
    <p class="texto"><%= buscar ? 'Prueba con otra parte del nombre o del correo.' : 'Registra el primero para poder crearle pedidos.' %></p>
    <a class="boton boton--secundario" href="/clientes/nuevo">Nuevo cliente</a>
  </div>
<% } else { %>
  <div class="tabla-marco">
    <table class="tabla">
      <thead>
        <tr>
          <th scope="col">Id</th>
          <th scope="col">Nombre</th>
          <th scope="col">Correo</th>
          <th scope="col">Teléfonos</th>
          <th scope="col" class="num">Edad</th>
          <th scope="col" class="num">Pedidos</th>
          <th scope="col"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        <% clientes.forEach((c) => { %>
          <tr>
            <td class="id"><%= fmt.id(c.id_cliente) %></td>
            <td><a class="enlace-fila" href="/clientes/<%= c.id_cliente %>"><%= fmt.nombre(c) %></a></td>
            <td class="recortar"><%= c.email %></td>
            <td class="mono"><%= c.telefonos %></td>
            <td class="num"><%= c.edad %></td>
            <td class="num"><%= c.num_pedidos %></td>
            <td class="acciones-celda"><a class="boton boton--fantasma" href="/clientes/<%= c.id_cliente %>/editar" aria-label="Editar a <%= fmt.nombre(c) %>">Editar</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/pie') %>
