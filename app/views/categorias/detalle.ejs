<%- include('../partials/cabeza') %>
<header class="encabezado">
  <div class="encabezado__texto">
    <nav class="migas" aria-label="Migas"><a href="/categorias">Categorías</a> / <span class="mono"><%= fmt.id(categoria.id_categoria) %></span></nav>
    <h1 class="titulo"><%= categoria.nombre %></h1>
  </div>
  <div class="acciones">
    <a class="boton boton--secundario" href="/categorias/<%= categoria.id_categoria %>/editar"><svg aria-hidden="true"><use href="#i-lapiz"/></svg>Editar</a>
  </div>
</header>

<% if (ok) { %><%- include('../partials/aviso', { tipo: 'ok', titulo: null, mensaje: ok }) %><div class="espacio"></div><% } %>
<% if (aviso) { %><%- include('../partials/aviso', { tipo: 'error', ...aviso }) %><div class="espacio"></div><% } %>

<section class="bloque" aria-labelledby="datos-titulo">
  <h2 class="seccion" id="datos-titulo">Datos</h2>
  <dl class="datos">
    <dt>Nombre</dt><dd><%= categoria.nombre %></dd>
    <dt>Productos</dt><dd class="mono"><%= categoria.num_productos %></dd>
  </dl>
</section>

<section class="bloque bloque--peligro" aria-labelledby="peligro-titulo">
  <h2 class="seccion" id="peligro-titulo">Eliminar</h2>
  <details class="confirmar">
    <summary class="boton boton--secundario">Eliminar categoría</summary>
    <form class="confirmar__panel" action="/categorias/<%= categoria.id_categoria %>/eliminar" method="post">
      <span><%= categoria.num_productos > 0
        ? 'Tiene productos asociados: la base de datos rechazará el borrado.'
        : 'Esta acción no se puede deshacer.' %></span>
      <button class="boton boton--peligro" type="submit">Sí, eliminar</button>
    </form>
  </details>
</section>
<%- include('../partials/pie') %>
