# Copia este archivo como .env y pon tus datos de MySQL.
# .env NO se sube a GitHub (está en .gitignore): cada quien tiene su clave.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_clave
DB_NAME=domicilios

# La app solo escucha en este equipo (no queda expuesta a la red)
APP_HOST=127.0.0.1
APP_PORT=3000
